{
  "name": "kechuang-risk-platform-public",
  "private": true,
  "version": "0.0.1",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.18.0",
    "npm": "11.6.2"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --experimental-strip-types server/production-server.ts",
    "build": "tsc -b && vite build && vite build --mode server",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "import:industry-risk": "node --experimental-strip-types scripts/import-industry-risk-sqlite.ts",
    "import:kcr-workbook": "node --experimental-strip-types scripts/import-kcr-workbook.ts",
    "score:kcr": "node --experimental-strip-types scripts/score-kcr-assessment.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts server/*.test.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "verify:localhost": "node scripts/verify-localhost.mjs",
    "start": "node dist/server/production-server.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^1.22.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "read-excel-file": "^9.3.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
