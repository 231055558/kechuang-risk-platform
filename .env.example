# Local PostgreSQL defaults. The Homebrew installation uses the current macOS
# account through peer-authenticated Unix sockets, so no password is required.
PGDATABASE=kechuang_risk
PGHOST=/tmp
PGPORT=5432

# For a remote or password-authenticated PostgreSQL instance, prefer one URL:
# DATABASE_URL=postgresql://user:password@host:5432/kechuang_risk

# Optional audited knowledge graph service. When GRAPH_API_ORIGIN is set,
# `npm run dev` reuses that service instead of starting the bundled demo graph.
# GRAPH_API_ORIGIN=http://127.0.0.1:8765
# VITE_GRAPH_WORKSPACE_URL=http://127.0.0.1:8765/
# VITE_GRAPH_WORKSPACE_REVISION=replace-when-the-upstream-snapshot-changes

