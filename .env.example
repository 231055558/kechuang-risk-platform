# Local PostgreSQL defaults. The Homebrew installation uses the current macOS
# account through peer-authenticated Unix sockets, so no password is required.
PGDATABASE=kechuang_risk
PGHOST=/tmp
PGPORT=5432

# For a remote or password-authenticated PostgreSQL instance, prefer one URL:
# DATABASE_URL=postgresql://user:password@host:5432/kechuang_risk

# Production web service
HOST=0.0.0.0
PORT=7878

# Optional AI guidance. Keep the real key in .env.local or the deployment
# secret store. Both values are required; without them the rule-based pages
# remain available and the AI endpoint returns 503.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_RESPONSES_PATH=/responses
# OPENAI_REASONING_EFFORT=medium
# OPENAI_VERBOSITY=low

# Provider-aware AI guidance configuration. When provider=deepseek, the
# service reads DEEPSEEK_API_KEY and does not reuse OPENAI_API_KEY.
# AI_GUIDANCE_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# AI_GUIDANCE_MODEL=deepseek-v4-flash
# AI_GUIDANCE_BASE_URL=https://api.deepseek.com
# AI_GUIDANCE_RESPONSES_PATH=/responses
# AI_GUIDANCE_REASONING_EFFORT=high
# AI_GUIDANCE_VERBOSITY=low
# AI guidance requests allow up to 60 seconds for reasoning and structured JSON.

# Risk graph runtime database. Never commit a real password.
RISK_GRAPH_PGHOST=
RISK_GRAPH_PGPORT=
RISK_GRAPH_PGDATABASE=
RISK_GRAPH_PGUSER=
RISK_GRAPH_PGPASSWORD=
RISK_GRAPH_PGSSLMODE=
RISK_GRAPH_PGPOOL_MAX=6

# Production/local graph lifecycle. "bundled" starts both tracked snapshots;
# "external" requires GRAPH_API_ORIGIN to point at a ready read-only service.
# GRAPH_RUNTIME_MODE=bundled
# GRAPH_API_ORIGIN=http://127.0.0.1:8766
# VITE_GRAPH_WORKSPACE_URL=risk-graph-workspace/
# VITE_GRAPH_WORKSPACE_REVISION=replace-when-the-upstream-snapshot-changes
