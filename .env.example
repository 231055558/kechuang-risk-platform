# Read the risk platform from the crawler project's master SQLite database.
# The API opens this file read-only; crawler updates remain owned by the
# D:\codex\risk_crawler_architecture data chain.
RISK_CRAWLER_MASTER_DB=D:\codex\risk_crawler_architecture\data\risk_data.sqlite

# Vite proxies /api to this local production API port.
API_PORT=5000
